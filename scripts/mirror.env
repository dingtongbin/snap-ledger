# 国内镜像环境变量。Bash 下：source scripts/mirror.env
# Windows 用户级持久化（已执行过）：
#   setx PUB_HOSTED_URL https://pub.flutter-io.cn
#   setx FLUTTER_STORAGE_BASE_URL https://storage.flutter-io.cn
export PUB_HOSTED_URL=https://pub.flutter-io.cn
export FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn

# Gradle/Maven 镜像已固化在工程文件中，无需环境变量：
# - android/gradle/wrapper/gradle-wrapper.properties -> 腾讯镜像分发 Gradle 9.1.0
# - android/settings.gradle.kts                     -> 阿里云插件仓库
# - android/build.gradle.kts                        -> 阿里云依赖仓库

# Windows 桌面运行时让应用/test 找到自带 sqlite3.dll：
# export PATH="$(pwd)/tool:$PATH"
